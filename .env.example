# ==============================================
# AgentOps AI - Environment Configuration
# ==============================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_SECRET_KEY=agentops-super-secure-production-ready-secret-key-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Supports both PostgreSQL (production) and SQLite (zero-config local dev & tests)
DATABASE_URL=sqlite+aiosqlite:///./agentops.db
# For PostgreSQL: postgresql+asyncpg://agentops:agentops_secret@localhost:5432/agentops_ai

# Redis Cache / Message Broker
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Vector Database (Qdrant)
# Supports local file/memory storage (:memory: or ./qdrant_data) or remote server
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_STORAGE_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=agentops_knowledge_base

# AI / LLM Configuration
# Optional: Set OPENAI_API_KEY for real OpenAI model calls.
# If omitted or offline, high-fidelity intelligent deterministic fallback agents run.
OPENAI_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
MAX_INVESTIGATION_STEPS=15
MAX_RETRY_LIMIT=3
TOKEN_BUDGET_PER_INVESTIGATION=50000

# Sandbox Security Configuration
SANDBOX_EXECUTION_TIMEOUT_SECONDS=45
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPU_PERCENT=80
SANDBOX_DOCKER_IMAGE=python:3.12-slim
ENABLE_DOCKER_SANDBOX=false

# GitHub Integration
GITHUB_TOKEN=
GITHUB_ORG=
